{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(?:@nestjs/config|@nestjs/core|@nestjs/common|@nestjs/testing|@nestjs/jwt|@nestjs/passport|@nestjs/typeorm|passport-jwt|jsonwebtoken)/)"
  ]
}
